#!/usr/bin/env python3
"""i3-focus-guard: workspaces stay isolated.

Policy: only windows mapped within MANUAL_GRACE_SEC of a manual keybinding
exec take focus naturally. Any other newly-mapped window that grabs focus
gets focus taken back, and if its process started before your last workspace
switch it is moved back to that previous workspace.

shortcut: commands typed by hand in a terminal count as background (click once to focus).
"""
import json
import os
import subprocess
import time

MANUAL_GRACE_SEC = 5.0
PIDFILE = "/tmp/i3-focus-guard.pid"
LOG = "/tmp/i3-focus-guard.log"


def log(*a):
    with open(LOG, "a") as f:
        print(time.strftime("%H:%M:%S"), *a, file=f, flush=True)


def sock():
    return subprocess.check_output(["i3", "--get-socketpath"]).decode().strip()


def run(sock_path, payload=None, msgtype="command"):
    cmd = ["i3-msg", "-s", sock_path, "-t", msgtype]
    if payload is not None:
        cmd.append(payload)
    return subprocess.check_output(cmd).decode()


def proc_start_epoch(pid):
    """Epoch seconds when pid started. Raises on failure."""
    with open("/proc/%d/stat" % pid) as f:
        stat = f.read()
    start_ticks = int(stat.rsplit(")", 1)[1].split()[19])  # field 22
    ticks = os.sysconf("SC_CLK_TCK")
    with open("/proc/stat") as f:
        for line in f:
            if line.startswith("btime "):
                return int(line.split()[1]) + start_ticks / ticks
    raise RuntimeError("no btime")


def find_node(sock_path, con_id):
    tree = json.loads(run(sock_path, msgtype="get_tree"))
    stack = [tree]
    while stack:
        n = stack.pop()
        if n.get("id") == con_id:
            return n
        stack.extend(n.get("nodes", []) + n.get("floating_nodes", []))
    return None


def focused_leaf_id(sock_path):
    tree = json.loads(run(sock_path, msgtype="get_tree"))
    found, stack = [], [tree]
    while stack:
        n = stack.pop()
        if n.get("focused"):
            found.append(n["id"])
        stack.extend(n.get("nodes", []) + n.get("floating_nodes", []))
    return found[-1] if found else None  # deepest focused container


def contains(node, con_id):
    stack = [node]
    while stack:
        n = stack.pop()
        if n.get("id") == con_id:
            return True
        stack.extend(n.get("nodes", []) + n.get("floating_nodes", []))
    return False


def pid_of_window(xid):
    out = subprocess.check_output(["xprop", "-id", str(xid), "_NET_WM_PID"]).decode()
    return int(out.split("=", 1)[1].strip())


def main():
    try:  # single instance: exit if a live guard already holds the pidfile
        with open(PIDFILE) as f:
            old = int(f.read().strip())
        os.kill(old, 0)
        print("i3-focus-guard already running as %d" % old)
        return
    except (OSError, ValueError, FileNotFoundError):
        pass
    sock_path = sock()
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    ws = json.loads(run(sock_path, msgtype="get_workspaces"))
    cur_ws = next(w["name"] for w in ws if w["focused"])
    prev_ws, switch_time = cur_ws, 0.0
    last_manual = 0.0
    history = []  # recent focused ids; victim = newest entry that isn't the new window
    boot_focused = focused_leaf_id(sock_path)
    if boot_focused is not None:
        history.append(boot_focused)
    log("ready, ws=%s" % cur_ws)
    while True:
        try:
            p = subprocess.Popen(
                ["i3-msg", "-s", sock_path, "-t", "subscribe",
                 '["window","workspace","binding"]'],
                stdout=subprocess.PIPE, text=True, bufsize=1)
            for line in p.stdout:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                now = time.time()
                if "binding" in ev:
                    b = ev["binding"]
                    if (ev.get("change") == "run" and b.get("input_type") == "keyboard"
                            and "exec" in b.get("command", "")):
                        last_manual = now
                elif "current" in ev:
                    if ev.get("change") == "focus":
                        prev_ws, switch_time = cur_ws, now
                        cur_ws = ev["current"]["name"]
                elif "container" in ev:
                    c = ev["container"]
                    if ev.get("change") == "focus":
                        if not history or history[-1] != c["id"]:
                            history.append(c["id"])
                            del history[:-20]
                    elif ev.get("change") == "new" and now - last_manual > MANUAL_GRACE_SEC:
                        victim = next((h for h in reversed(history) if h != c["id"]), None)
                        time.sleep(0.4)
                        node = find_node(sock_path, c["id"])
                        leaf = focused_leaf_id(sock_path)
                        log("new", c["id"], "victim=", victim, "leaf=", leaf,
                            "mapped=", node is not None and node.get("window"))
                        if node is not None and leaf is not None and contains(node, leaf):
                            try:
                                pstart = None
                                if node.get("window"):
                                    try:
                                        pstart = proc_start_epoch(pid_of_window(node["window"]))
                                    except Exception as e:
                                        log("nopid", c["id"], e)
                                if pstart and pstart < switch_time and cur_ws != prev_ws:
                                    run(sock_path, '[con_id=%s] move to workspace "%s"'
                                        % (c["id"], prev_ws))
                                    log("moveback", c["id"], "to", prev_ws)
                                if victim is not None and victim != leaf:
                                    run(sock_path, '[con_id=%s] focus' % victim)
                                    log("refocus", leaf, "->", victim)
                            except Exception as e:
                                log("err", e)
            p.wait()
        except Exception as e:
            log("reconnect", e)
        time.sleep(2)


if __name__ == "__main__":
    main()
