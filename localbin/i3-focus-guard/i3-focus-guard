#!/usr/bin/env python3
"""i3-focus-guard: workspaces stay isolated.

Policy: the manager diverts every tiling birth to holding workspace 20
pre-map; the daemon moves each arrival exactly once to its origin
workspace (or back where i3 targeted it, automation pins to ws10).
Same-workspace arrivals take focus; background arrivals keep prior focus
restored with an urgency hint, never taking focus. Floating dialogs bypass
the pen and map directly. Background arrivals never tile the visible
layout, even briefly. Births found outside the holding pen are staged to
the scratchpad as fallback.

Runtime deps: i3-msg, xprop, xdotool (urgency hint).

Dialog-like windows float as intended; background ones rejoin their
parent workspace instead of staying where focused.
shortcut: background dialog landing on an empty focused workspace stays put.
"""
import json
import os
import socket
import struct
import subprocess
import time

PIDFILE = "/tmp/i3-focus-guard.pid"
LOG = "/tmp/i3-focus-guard.log"
HOLD_WS = "20"
STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "i3-focus-guard")
JOURNAL_FILE = os.path.join(STATE_DIR, "ws.json")
JOURNAL_TRUST_SECS = 24 * 3600
JOURNAL_PRUNE_SECS = 7 * 24 * 3600
SWEEP_SECS = 30


def is_held_ws(name):
    """Holding pen or scratchpad: invisible by design, never an origin."""
    return name == HOLD_WS or (name or "").startswith("__i3")


def log(*a):
    with open(LOG, "a") as f:
        print(time.strftime("%H:%M:%S"), *a, file=f, flush=True)


def sock():
    return subprocess.check_output(["i3", "--get-socketpath"]).decode().strip()


def run(sock_path, payload=None, msgtype="command"):
    cmd = ["i3-msg", "-s", sock_path, "-t", msgtype]
    if payload is not None:
        cmd.append(payload)
    return subprocess.check_output(cmd).decode()


def walk(node, _ws=None):
    """Depth-first (node, enclosing-workspace) pairs, tiling + floating."""
    if node.get("type") == "workspace":
        _ws = node
    yield node, _ws
    for c in node.get("nodes", []) + node.get("floating_nodes", []):
        yield from walk(c, _ws)


def pid_is_guard(pid):
    """True if pid's cmdline is the guard (rules out PID reuse)."""
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return b"i3-focus-guard" in f.read()
    except Exception:
        return False


def workspace_name(tree, con_id):
    """Name of the workspace containing con_id, or None."""
    return next(
        (ws["name"] for n, ws in walk(tree)
         if n.get("id") == con_id and ws is not None),
        None)


def load_journal():
    """Last-known xid -> [workspace, class, epoch]; {} when absent."""
    try:
        with open(JOURNAL_FILE) as f:
            data = json.load(f)
        return {str(k): v for k, v in data.items() if isinstance(v, list)}
    except Exception:
        return {}


def save_journal(journal):
    if journal is None:
        return
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(JOURNAL_FILE, "w") as f:
            json.dump(journal, f)
    except Exception as e:
        log("journal-err", e)


def refresh_journal(tree, journal, now=None):
    """Record homes for visible windows; pen/scratchpad never recorded."""
    if journal is None or tree is None:
        return journal
    now = now if now is not None else time.time()
    for n, ws in walk(tree):
        if n.get("window") and ws is not None and not is_held_ws(ws["name"]):
            wp = n.get("window_properties") or {}
            journal[str(n["window"])] = [ws["name"], wp.get("class") or "", now]
    for k in [k for k, v in journal.items()
              if not isinstance(v, list) or len(v) < 3
              or now - v[2] > JOURNAL_PRUNE_SECS]:
        del journal[k]
    save_journal(journal)
    return journal


def journal_home(journal, xid, cls, now=None):
    """Journaled home ws for xid, or None.

    xid survives i3 restart (con_id does not), but X recycles xids, so a
    same-class entry younger than a day is required before trusting it.
    """
    now = now if now is not None else time.time()
    try:
        ws_name, jcls, ts = (journal or {}).get(str(xid), (None, None, None))
    except Exception:
        return None
    if (ws_name and jcls == (cls or "") and not is_held_ws(ws_name)
            and isinstance(ts, (int, float)) and now - ts < JOURNAL_TRUST_SECS):
        return ws_name
    return None


def record_home(journal, node, ws_name):
    """Remember where a delivered window lives (non-dialogs only)."""
    if (journal is None or not node or not node.get("window")
            or not ws_name or is_held_ws(ws_name)):
        return
    wp = node.get("window_properties") or {}
    journal[str(node["window"])] = [ws_name, wp.get("class") or "", time.time()]
    save_journal(journal)


def choose_target(origin, home, new_ws):
    """Delivery preference: ancestry origin, then last-known home, then target."""
    if origin:
        return origin
    if home and not is_held_ws(home):
        return home
    return new_ws


def _selfcheck():
    assert choose_target("2", "3", "1") == "2"
    assert choose_target(None, "3", "1") == "3"
    assert choose_target(None, None, "1") == "1"
    assert choose_target(None, "20", "1") == "1"
    j = {"7": ["2", "Alacritty", time.time()]}
    assert journal_home(j, 7, "Alacritty") == "2"
    assert journal_home(j, 7, "Chrome") is None
    assert journal_home({"7": ["2", "Alacritty", 0]}, 7, "Alacritty") is None
    assert journal_home({}, 7, "Alacritty") is None


if os.environ.get("I3FG_SELFCHECK"):
    _selfcheck()


def ppid_of(pid):
    """Parent pid of pid via /proc. Raises on failure."""
    with open("/proc/%d/stat" % pid) as f:
        stat = f.read()
    return int(stat.rsplit(")", 1)[1].split()[1])  # field 4


def lineage(new_pid, ppid_fn=None):
    """Self plus OS ancestors, nearest first (pure)."""
    getppid = ppid_fn or ppid_of
    chain, seen, pid, depth = [new_pid], {new_pid}, new_pid, 0
    while depth < 32:
        try:
            pid = getppid(pid)
        except Exception:
            break
        if pid in (0, 1) or pid in seen:
            break
        seen.add(pid)
        chain.append(pid)
        depth += 1
    return chain


def resolve_origin(new_pid, pid_to_ws, ppid_fn=None):
    """Nearest ancestor workspace of new_pid, or None.

    Walks OS process ancestry starting at the parent; the first ancestor
    pid owning a visible window wins. Self pid is never consulted, so a
    single-process browser reusing its pid yields no origin (urgency-only).
    """
    for pid in lineage(new_pid, ppid_fn)[1:]:
        if pid in pid_to_ws:
            return pid_to_ws[pid]
    return None


def family_workspace(new_pid, pid_to_ws, ppid_fn=None):
    """Workspace owned unanimously by new_pid's process family, or None.

    Family is new_pid plus OS ancestors; self is included so a
    pid-reusing single-process dialog matches its own browser windows.
    Exactly one distinct workspace wins without consulting ancestry;
    split or windowless families return None (caller falls back).
    """
    seen = set(lineage(new_pid, ppid_fn))
    found = set(ws for q, ws in pid_to_ws.items() if q in seen)
    return found.pop() if len(found) == 1 else None


def pid_workspace_map(sock_path, exclude_con_id=None):
    """Map owner pid -> workspace name for visible windows.

    Visible = on a real workspace (not __i3_scratch, not the holding pen:
    pen occupants are unsorted arrivals, never origins). Named workspaces
    count too, `move to workspace "<name>"` accepts names.
    """
    tree = json.loads(run(sock_path, msgtype="get_tree"))
    pid_to_ws = {}
    for n, ws in walk(tree):
        if n.get("window") and n.get("id") != exclude_con_id:
            if ws is not None and not is_held_ws(ws["name"]):
                try:
                    pid_to_ws[pid_of_window(n["window"])] = ws["name"]
                except Exception:
                    pass
    return pid_to_ws


def is_automation_window(node):
    """True for ws10 automation pins (assign + no_focus pairs); never move."""
    wp = node.get("window_properties") or {}
    for k in ("class", "instance"):
        v = wp.get(k) or ""
        if v.startswith("Syntheflow"):
            return True
    return False


DIALOG_TYPES = {"dialog", "utility", "toolbar", "splash", "menu",
                "dropdown_menu", "popup_menu", "notification"}
DIALOG_ROLES = {"pop-up", "task_dialog"}


def is_dialog_props(props):
    """True for dialog-like windows; they float as intended, never tile."""
    props = props or {}
    return ((props.get("window_type") or "") in DIALOG_TYPES
            or (props.get("window_role") or "") in DIALOG_ROLES
            or bool(props.get("transient_for")))


def is_dialog_node(node):
    """True for dialog-like or already-floating windows (field-layout safe).

    get_tree field placement varies; the floating-state check covers any
    dialog the manager already floated via the config rules above.
    """
    node = node or {}
    if is_dialog_props(node.get("window_properties")):
        return True
    if (node.get("window_type") or "") in DIALOG_TYPES:
        return True
    return (node.get("floating") or "").endswith("_on")


def live_victim(history, new_id, find_fn):
    """Newest history entry that isn't the new window and still exists."""
    for h in reversed(history):
        if h != new_id and find_fn(h) is not None:
            return h
    return None


def stack_victim_from_tree(tree, new_id, ws_name):
    """Previously focused window on ws_name via i3 focus stacks (pure half)."""
    by_id = dict((n["id"], n) for n, _ in walk(tree))

    def window_below(fid):
        n = by_id.get(fid)
        while n is not None and (not n.get("window") or n["id"] == new_id):
            kids = [k for k in n.get("focus", []) if k != new_id]
            if not kids:
                return None
            n = by_id.get(kids[0])
        return n["id"] if n is not None else None

    for n in by_id.values():
        if n.get("type") == "workspace" and n.get("name") == ws_name:
            for fid in n.get("focus", []):
                v = window_below(fid)
                if v is not None:
                    return v
    return None


def stack_victim(sock_path, new_id, ws_name):
    """Previously focused window on ws_name via i3 focus stacks.

    Event history goes stale whenever the subscribe stream drops; the
    workspace focus list is read fresh, so it survives those gaps. Falls
    back to None (caller tries history next).
    """
    try:
        tree = json.loads(run(sock_path, msgtype="get_tree"))
    except Exception:
        return None
    return stack_victim_from_tree(tree, new_id, ws_name)


def find_node(sock_path, con_id):
    tree = json.loads(run(sock_path, msgtype="get_tree"))
    return next((n for n, _ in walk(tree) if n.get("id") == con_id), None)


def ws_empty_except(tree, ws_name, con_id):
    """True if ws_name holds no window leaf besides con_id (pure)."""
    return not any(n.get("window") and n.get("id") != con_id
                   for n, ws in walk(tree)
                   if ws is not None and ws.get("name") == ws_name)


def set_urgent(xid):
    """Urgency hint without stealing focus.

    There is no valid `urgent` i3 command; the hint is the WM urgency
    flag (xdotool sets it, i3 surfaces window + workspace urgent).
    """
    try:
        subprocess.check_output(
            ["xdotool", "set_window", "--urgency", "1", str(xid)],
            stderr=subprocess.STDOUT)
    except Exception as e:
        log("urgent-err", xid, e)


def ensure_tiled(sock_path, con_id):
    """Floating off so delivered arrivals tile; scratchpad float never leaks."""
    run(sock_path, '[con_id=%s] floating disable' % con_id)


def ensure_floating(sock_path, con_id):
    """Floating on so dialog-like arrivals float as intended."""
    run(sock_path, '[con_id=%s] floating enable' % con_id)


def deliver_to(sock_path, con_id, target_ws, cur_ws, staged):
    """Move a birth to its delivery workspace. Returns True when the
    window was shown from the scratchpad (focus stolen, caller refocuses).

    i3 misroutes `move to workspace` when the target is the visible
    workspace (lands elsewhere, still replies success), so staged windows
    bound for the focused workspace are shown from the scratchpad instead.
    """
    if target_ws == cur_ws:
        if not staged:
            run(sock_path, '[con_id=%s] move to scratchpad' % con_id)
            log("restage", con_id)
        run(sock_path, '[con_id=%s] scratchpad show' % con_id)
        return True
    run(sock_path, '[con_id=%s] move to workspace "%s"'
        % (con_id, target_ws))
    return False


def focused_leaf_id(sock_path):
    tree = json.loads(run(sock_path, msgtype="get_tree"))
    found = [n["id"] for n, _ in walk(tree) if n.get("focused")]
    return found[-1] if found else None  # deepest focused container


def contains(node, con_id):
    return any(n.get("id") == con_id for n, _ in walk(node))


def pid_of_window(xid):
    out = subprocess.check_output(["xprop", "-id", str(xid), "_NET_WM_PID"]).decode()
    return int(out.split("=", 1)[1].strip())


def open_events(sock_path):
    """Persistent IPC event socket; i3-msg subscribe exits after window::new
    (rc 0), so the guard holds its own socket instead (stdlib only)."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(sock_path)
    payload = b'["window","workspace"]'
    s.sendall(b"i3-ipc" + struct.pack("II", len(payload), 2) + payload)
    typ, ack = read_msg(s)
    if not (ack or {}).get("success"):
        s.close()
        raise RuntimeError("subscribe rejected: %r" % (ack,))
    s.settimeout(SWEEP_SECS)  # idle gaps double as pen-sweep ticks
    return s


def read_msg(s):
    """One IPC reply; (None, None) on clean EOF. Raises on protocol errors."""
    hdr = b""
    while len(hdr) < 14:
        chunk = s.recv(14 - len(hdr))
        if not chunk:
            return None, None
        hdr += chunk
    if hdr[:6] != b"i3-ipc":
        raise RuntimeError("bad ipc magic")
    ln = struct.unpack("I", hdr[6:10])[0]
    buf = b""
    while len(buf) < ln:
        chunk = s.recv(ln - len(buf))
        if not chunk:
            raise RuntimeError("truncated ipc payload")
        buf += chunk
    return struct.unpack("I", hdr[10:14])[0], json.loads(buf)


def tree_windows(tree):
    """(con_id, xid) pairs for window-bearing cons (pure)."""
    return set((n["id"], n.get("window"))
               for n, _ in walk(tree) if n.get("window"))


def handle_new(sock_path, con_id, cur_ws, history, journal=None,
               stage=True, ev_props=None):
    """Deliver a birth from the holding pen, then refocus + urgency.

    Rule-held births skip staging (already invisible); births found
    elsewhere are staged pre-delivery as fallback.
    """
    try:
        pre_tree = json.loads(run(sock_path, msgtype="get_tree"))
    except Exception:
        pre_tree = None
    pre_ws = workspace_name(pre_tree, con_id) if pre_tree is not None else None
    held_on_arrival = is_held_ws(pre_ws)
    pre_node = next(
        (n for n, _ in walk(pre_tree) if n.get("id") == con_id),
        None) if pre_tree is not None else None
    pre_floating = ((pre_node or {}).get("floating") or "").endswith("_on")
    if stage and held_on_arrival:
        log("pen", con_id)
    if pre_floating:
        log("float-skip", con_id)
    if (stage and not held_on_arrival and not pre_floating
            and not is_automation_window({"window_properties": ev_props})
            and not is_dialog_props(ev_props)):
        try:
            reply = run(sock_path, '[con_id=%s] move to scratchpad' % con_id)
            log("stage", con_id)
            try:
                ok = json.loads(reply)[0].get("success", False)
            except Exception:
                ok = False
            log("hide-reply", con_id, "success" if ok else "failed")
        except Exception as e:
            log("stage-err", con_id, e)
            log("hide-reply", con_id, "error")
    time.sleep(0.4)
    node = find_node(sock_path, con_id)
    leaf = focused_leaf_id(sock_path)
    log("new", con_id, "leaf=", leaf,
        "mapped=", node is not None and node.get("window"))
    if node is None or leaf is None:
        return node
    dialog = is_dialog_node(node)
    try:
        tree_now = json.loads(run(sock_path, msgtype="get_tree"))
    except Exception:
        tree_now = None
    staged = (tree_now is not None
              and (workspace_name(tree_now, con_id) or "").startswith("__i3"))
    held = (staged or (tree_now is not None
                       and is_held_ws(workspace_name(tree_now, con_id))))
    # Gap births (stage=False) skip staging, so a quiet one never contains
    # focus yet still needs move+refocus+badge below; only the live path
    # may bail here. Holding-pen births are already invisible, never bailed.
    if stage and not held and not contains(node, leaf):
        return node
    # i3 targets the focused workspace; the pen holds where it would land
    new_ws = cur_ws
    if not held and tree_now is not None:
        new_ws = workspace_name(tree_now, con_id) or cur_ws
    empty_first = (tree_now is not None
                   and ws_empty_except(tree_now, new_ws, con_id))
    if empty_first and (not held or stage):
        # Live births (pen-held live, or pre-rule fallback) keep first-
        # window focus. Drain-held recoveries (held, stage=False) fall
        # through to origin sort so restart preserves layout sessions.
        log("firstwin", con_id, "to", new_ws, "leave focused")
        if held and not dialog:
            deliver_to(sock_path, con_id, new_ws, cur_ws, staged)
        if dialog:
            ensure_floating(sock_path, con_id)
        else:
            ensure_tiled(sock_path, con_id)
            record_home(journal, node, new_ws)
    else:
        victim = (stack_victim(sock_path, con_id, new_ws)
                  or live_victim(history, con_id,
                                 lambda i: find_node(sock_path, i)))
        shown = False
        final_ws = new_ws
        try:
            if is_automation_window(node) and not dialog:
                autom_ws = (workspace_name(tree_now, con_id)
                            if tree_now is not None else None)
                if not staged and autom_ws == "10":
                    log("autom-skip", con_id)
                else:
                    shown = deliver_to(sock_path, con_id, "10", cur_ws, staged)
                    ensure_tiled(sock_path, con_id)
                    final_ws = "10"
                    log("autom-rescue", con_id)
            else:
                origin = None
                try:
                    if node.get("window"):
                        new_pid = pid_of_window(node["window"])
                        pid_ws = pid_workspace_map(
                            sock_path, exclude_con_id=con_id)
                        origin = family_workspace(new_pid, pid_ws)
                        if origin is None:
                            origin = resolve_origin(new_pid, pid_ws)
                except Exception as e:
                    log("nopid", con_id, e)
                settle = ensure_floating if dialog else ensure_tiled
                if origin and origin != new_ws:
                    shown = deliver_to(sock_path, con_id, origin, cur_ws, staged)
                    settle(sock_path, con_id)
                    final_ws = origin
                    log("dialog-moveback" if dialog else "moveback",
                        con_id, "to", origin)
                elif held:
                    home = None
                    if not dialog:
                        wp = node.get("window_properties") or {}
                        home = journal_home(journal, node.get("window"),
                                            wp.get("class") or "")
                    target = new_ws if dialog else choose_target(origin, home,
                                                                 new_ws)
                    shown = deliver_to(sock_path, con_id, target, cur_ws,
                                       staged)
                    settle(sock_path, con_id)
                    final_ws = target
                    # shortcut: recycled-xid homes are trusted only via
                    # journal_home (same class, <1 day); upgrade when to
                    # per-launch tokens if that ever misdelivers.
                    if home is not None and target == home and target != new_ws:
                        log("home", con_id, "to", target)
                    else:
                        log("dialog-unstage" if dialog else "unstage",
                            con_id, "to", target)
                elif dialog:
                    settle(sock_path, con_id)
                    log("dialog-float", con_id, "on", new_ws)
                else:
                    settle(sock_path, con_id)
                    log("fallback", con_id, "urgency-only on", new_ws)
            # Fresh focus: the user may have switched workspaces during the
            # settle delay, so autofocus compares against now, not birth time.
            try:
                _ws = json.loads(run(sock_path, msgtype="get_workspaces"))
                cur_now = next(w["name"] for w in _ws if w["focused"])
            except Exception:
                cur_now = cur_ws
            if (final_ws == cur_now and not is_automation_window(node)
                    and node.get("window")):
                run(sock_path, '[con_id=%s] focus' % con_id)
                log("autofocus", con_id, "on", final_ws)
            else:
                # Gap births can sit off the focused workspace; focusing there
                # would switch desktops, so refocus stays on the focused one.
                # Scratchpad-show deliveries steal focus even when the victim is
                # the pre-birth leaf, so those always refocus.
                if (victim is not None and (shown or victim != leaf)
                        and new_ws == cur_now
                        and find_node(sock_path, victim) is not None):
                    run(sock_path, '[con_id=%s] focus' % victim)
                    log("refocus", leaf, "->", victim)
                if node.get("window"):
                    # last: the hint sticks only once the
                    # window is unfocused (set while focused
                    # is cleared)
                    set_urgent(node["window"])
                if not dialog:
                    record_home(journal, node, final_ws)
        except Exception as e:
            log("err", e)
    return node


def reconcile(sock_path, cur_ws, history, journal, known):
    """Resync focused ws, refresh journal, deliver gap births + pen inbox.

    Returns (cur_ws, known-pairs). Diffs on con_id: XID swaps on a known
    window are re-maps, never births.
    """
    try:  # resync so origin resolution never acts on a stale
        # focused workspace, then reconcile windows mapped
        # while unsubscribed
        ws = json.loads(run(sock_path, msgtype="get_workspaces"))
        cur_ws = next(w["name"] for w in ws if w["focused"])
    except Exception as e:
        log("wsresync", e)
    try:
        tree = json.loads(run(sock_path, msgtype="get_tree"))
    except Exception as e:
        log("resync", e)
        tree = None
    if tree is None:
        return cur_ws, known
    refresh_journal(tree, journal)
    cur = tree_windows(tree)
    known_cons = set(c for c, _ in known)
    for con_id, _xid in sorted(cur):
        if con_id not in known_cons:
            handle_new(sock_path, con_id, cur_ws, history, journal, stage=False)
    # Inbox drain: i3 restart re-applies the holding-pen rule to
    # every window and daemon restarts inherit the backlog; those
    # carry known ids so the diff above misses them. Fresh births
    # (unknown ids) are left to their own events.
    fresh_ids = set(c for c, _ in cur) - set(c for c, _ in known)
    for n, ws in walk(tree):
        if (n.get("window") and ws is not None
                and ws.get("name") == HOLD_WS
                and n["id"] in set(c for c, _ in known)
                and n["id"] not in fresh_ids):
            handle_new(sock_path, n["id"], cur_ws, history, journal,
                       stage=False)
    return cur_ws, set(cur)


def main():
    try:  # single instance: exit if a live guard already holds the pidfile
        with open(PIDFILE) as f:
            old = int(f.read().strip())
        os.kill(old, 0)
        if not pid_is_guard(old):
            raise ValueError("stale pidfile, pid %d reused" % old)
        print("i3-focus-guard already running as %d" % old)
        return
    except (OSError, ValueError, FileNotFoundError):
        pass
    sock_path = sock()
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    ws = json.loads(run(sock_path, msgtype="get_workspaces"))
    cur_ws = next(w["name"] for w in ws if w["focused"])
    history = []  # fallback focus trail; primary victim comes from focus stacks
    boot_focused = focused_leaf_id(sock_path)
    if boot_focused is not None:
        history.append(boot_focused)
    journal = load_journal()
    try:  # baseline so pre-existing windows are never treated as new
        boot_tree = json.loads(run(sock_path, msgtype="get_tree"))
        known = tree_windows(boot_tree)
        refresh_journal(boot_tree, journal)
    except Exception:
        known = set()
    log("ready, ws=%s" % cur_ws)
    while True:
        try:
            ev_sock = open_events(sock_path)
            cur_ws, known = reconcile(sock_path, cur_ws, history, journal,
                                      known)
            while True:
                try:
                    _typ, ev = read_msg(ev_sock)
                except socket.timeout:
                    # Idle sweep: strays parked on the pen by a rule
                    # re-fire (reload/restart) drain home within seconds.
                    cur_ws, known = reconcile(sock_path, cur_ws, history,
                                              journal, known)
                    continue
                if ev is None:
                    break  # clean EOF; resubscribe below
                if "current" in ev:
                    if ev.get("change") == "focus":
                        cur_ws = ev["current"]["name"]
                elif "container" in ev:
                    c = ev["container"]
                    if ev.get("change") == "focus":
                        if not history or history[-1] != c["id"]:
                            history.append(c["id"])
                            del history[:-20]
                    elif ev.get("change") == "move":
                        # Rule re-fires (bindsym reload/restart) park known
                        # windows on the pen with no window::new; drain them
                        # home at once instead of waiting for the sweep.
                        mid = (c or {}).get("id")
                        if (mid is not None
                                and any(k == mid for k, _ in known)):
                            try:
                                mtree = json.loads(
                                    run(sock_path, msgtype="get_tree"))
                            except Exception:
                                mtree = None
                            if (mtree is not None
                                    and workspace_name(mtree, mid) == HOLD_WS):
                                log("move-pen", mid)
                                mnode = handle_new(
                                    sock_path, mid, cur_ws, history, journal,
                                    stage=False)
                                known.add((mid, mnode.get("window")
                                           if mnode else None))
                    elif ev.get("change") == "new":
                        # shortcut: con_ids are monotonic per session and
                        # rebuilt on restart, so a known con is a re-managed
                        # window, never a birth; staging it would hide it.
                        if any(k == c["id"] for k, _ in known):
                            log("known-skip", c["id"])
                            continue
                        node = handle_new(sock_path, c["id"], cur_ws, history,
                                          journal,
                                          ev_props=c.get("window_properties"))
                        known.add((c["id"], node.get("window") if node else None))
            try:
                ev_sock.close()
            except Exception:
                pass
            log("resub")  # event stream ended; reconnecting
        except Exception as e:
            log("reconnect", e)
        time.sleep(1)


if __name__ == "__main__":
    main()
