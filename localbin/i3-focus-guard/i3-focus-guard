#!/usr/bin/env python3
"""i3-focus-guard: workspaces stay isolated.

Policy: every newly-mapped window is staged to the scratchpad before it
can tile the focused workspace, then moved to its origin workspace (or
back where i3 targeted it) with prior focus restored. Background arrivals
never shift the visible layout, even briefly. First window on an empty
workspace stays focused per window-manager design.

Runtime deps: i3-msg, xprop, xdotool (urgency hint).

shortcut: commands typed by hand in a terminal count as background (click once to focus).
"""
import json
import os
import socket
import struct
import subprocess
import time

PIDFILE = "/tmp/i3-focus-guard.pid"
LOG = "/tmp/i3-focus-guard.log"


def log(*a):
    with open(LOG, "a") as f:
        print(time.strftime("%H:%M:%S"), *a, file=f, flush=True)


def sock():
    return subprocess.check_output(["i3", "--get-socketpath"]).decode().strip()


def run(sock_path, payload=None, msgtype="command"):
    cmd = ["i3-msg", "-s", sock_path, "-t", msgtype]
    if payload is not None:
        cmd.append(payload)
    return subprocess.check_output(cmd).decode()


def walk(node, _ws=None):
    """Depth-first (node, enclosing-workspace) pairs, tiling + floating."""
    if node.get("type") == "workspace":
        _ws = node
    yield node, _ws
    for c in node.get("nodes", []) + node.get("floating_nodes", []):
        yield from walk(c, _ws)


def pid_is_guard(pid):
    """True if pid's cmdline is the guard (rules out PID reuse)."""
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return b"i3-focus-guard" in f.read()
    except Exception:
        return False


def workspace_name(tree, con_id):
    """Name of the workspace containing con_id, or None."""
    return next(
        (ws["name"] for n, ws in walk(tree)
         if n.get("id") == con_id and ws is not None),
        None)


def ppid_of(pid):
    """Parent pid of pid via /proc. Raises on failure."""
    with open("/proc/%d/stat" % pid) as f:
        stat = f.read()
    return int(stat.rsplit(")", 1)[1].split()[1])  # field 4


def resolve_origin(new_pid, pid_to_ws, ppid_fn=None):
    """Nearest ancestor workspace of new_pid, or None.

    Walks OS process ancestry starting at the parent; the first ancestor
    pid owning a visible window wins. Self pid is never consulted, so a
    single-process browser reusing its pid yields no origin (urgency-only).
    """
    getppid = ppid_fn or ppid_of
    seen, pid, depth = {new_pid}, new_pid, 0
    while depth < 32:
        try:
            pid = getppid(pid)
        except Exception:
            return None
        if pid in (0, 1) or pid in seen:
            return None
        seen.add(pid)
        if pid in pid_to_ws:
            return pid_to_ws[pid]
        depth += 1
    return None


def family_workspace(new_pid, pid_to_ws, ppid_fn=None):
    """Workspace owned unanimously by new_pid's process family, or None.

    Family is new_pid plus OS ancestors; self is included so a
    pid-reusing single-process dialog matches its own browser windows.
    Exactly one distinct workspace wins without consulting ancestry;
    split or windowless families return None (caller falls back).
    """
    getppid = ppid_fn or ppid_of
    lineage, pid, depth = {new_pid}, new_pid, 0
    while depth < 32:
        try:
            pid = getppid(pid)
        except Exception:
            break
        if pid in (0, 1) or pid in lineage:
            break
        lineage.add(pid)
        depth += 1
    found = set(ws for q, ws in pid_to_ws.items() if q in lineage)
    return found.pop() if len(found) == 1 else None


def pid_workspace_map(sock_path, exclude_con_id=None):
    """Map owner pid -> workspace name for visible windows.

    Visible = on a real workspace (not __i3_scratch); named workspaces
    count too, `move to workspace "<name>"` accepts names.
    """
    tree = json.loads(run(sock_path, msgtype="get_tree"))
    pid_to_ws = {}
    for n, ws in walk(tree):
        if n.get("window") and n.get("id") != exclude_con_id:
            if ws is not None and not ws["name"].startswith("__i3"):
                try:
                    pid_to_ws[pid_of_window(n["window"])] = ws["name"]
                except Exception:
                    pass
    return pid_to_ws


def is_automation_window(node):
    """True for ws10 automation pins (assign + no_focus pairs); never move."""
    wp = node.get("window_properties") or {}
    for k in ("class", "instance"):
        v = wp.get(k) or ""
        if v.startswith("Syntheflow"):
            return True
    return False


def live_victim(history, new_id, find_fn):
    """Newest history entry that isn't the new window and still exists."""
    for h in reversed(history):
        if h != new_id and find_fn(h) is not None:
            return h
    return None


def stack_victim_from_tree(tree, new_id, ws_name):
    """Previously focused window on ws_name via i3 focus stacks (pure half)."""
    by_id = dict((n["id"], n) for n, _ in walk(tree))

    def window_below(fid):
        n = by_id.get(fid)
        while n is not None and (not n.get("window") or n["id"] == new_id):
            kids = [k for k in n.get("focus", []) if k != new_id]
            if not kids:
                return None
            n = by_id.get(kids[0])
        return n["id"] if n is not None else None

    for n in by_id.values():
        if n.get("type") == "workspace" and n.get("name") == ws_name:
            for fid in n.get("focus", []):
                v = window_below(fid)
                if v is not None:
                    return v
    return None


def stack_victim(sock_path, new_id, ws_name):
    """Previously focused window on ws_name via i3 focus stacks.

    Event history goes stale whenever the subscribe stream drops; the
    workspace focus list is read fresh, so it survives those gaps. Falls
    back to None (caller tries history next).
    """
    try:
        tree = json.loads(run(sock_path, msgtype="get_tree"))
    except Exception:
        return None
    return stack_victim_from_tree(tree, new_id, ws_name)


def find_node(sock_path, con_id):
    tree = json.loads(run(sock_path, msgtype="get_tree"))
    return next((n for n, _ in walk(tree) if n.get("id") == con_id), None)


def ws_empty_except(tree, ws_name, con_id):
    """True if ws_name holds no window leaf besides con_id (pure)."""
    return not any(n.get("window") and n.get("id") != con_id
                   for n, ws in walk(tree)
                   if ws is not None and ws.get("name") == ws_name)


def set_urgent(xid):
    """Urgency hint without stealing focus.

    There is no valid `urgent` i3 command; the hint is the WM urgency
    flag (xdotool sets it, i3 surfaces window + workspace urgent).
    """
    try:
        subprocess.check_output(
            ["xdotool", "set_window", "--urgency", "1", str(xid)],
            stderr=subprocess.STDOUT)
    except Exception as e:
        log("urgent-err", xid, e)


def focused_leaf_id(sock_path):
    tree = json.loads(run(sock_path, msgtype="get_tree"))
    found = [n["id"] for n, _ in walk(tree) if n.get("focused")]
    return found[-1] if found else None  # deepest focused container


def contains(node, con_id):
    return any(n.get("id") == con_id for n, _ in walk(node))


def pid_of_window(xid):
    out = subprocess.check_output(["xprop", "-id", str(xid), "_NET_WM_PID"]).decode()
    return int(out.split("=", 1)[1].strip())


def open_events(sock_path):
    """Persistent IPC event socket; i3-msg subscribe exits after window::new
    (rc 0), so the guard holds its own socket instead (stdlib only)."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(sock_path)
    payload = b'["window","workspace"]'
    s.sendall(b"i3-ipc" + struct.pack("II", len(payload), 2) + payload)
    typ, ack = read_msg(s)
    if not (ack or {}).get("success"):
        s.close()
        raise RuntimeError("subscribe rejected: %r" % (ack,))
    return s


def read_msg(s):
    """One IPC reply; (None, None) on clean EOF. Raises on protocol errors."""
    hdr = b""
    while len(hdr) < 14:
        chunk = s.recv(14 - len(hdr))
        if not chunk:
            return None, None
        hdr += chunk
    if hdr[:6] != b"i3-ipc":
        raise RuntimeError("bad ipc magic")
    ln = struct.unpack("I", hdr[6:10])[0]
    buf = b""
    while len(buf) < ln:
        chunk = s.recv(ln - len(buf))
        if not chunk:
            raise RuntimeError("truncated ipc payload")
        buf += chunk
    return struct.unpack("I", hdr[10:14])[0], json.loads(buf)


def tree_windows(tree):
    """(con_id, xid) pairs for window-bearing cons (pure)."""
    return set((n["id"], n.get("window"))
               for n, _ in walk(tree) if n.get("window"))


def handle_new(sock_path, con_id, cur_ws, history, stage=True, ev_props=None):
    """Stage to scratchpad pre-map, then origin move-back + refocus + urgency.

    Staging keeps the window out of the focused workspace tiling entirely,
    so background arrivals never shift the visible layout even briefly.
    """
    if stage and not is_automation_window({"window_properties": ev_props}):
        try:
            reply = run(sock_path, '[con_id=%s] move to scratchpad' % con_id)
            log("stage", con_id)
            try:
                ok = json.loads(reply)[0].get("success", False)
            except Exception:
                ok = False
            log("hide-reply", con_id, "success" if ok else "failed")
        except Exception as e:
            log("stage-err", con_id, e)
            log("hide-reply", con_id, "failed")
    time.sleep(0.4)
    node = find_node(sock_path, con_id)
    leaf = focused_leaf_id(sock_path)
    log("new", con_id, "leaf=", leaf,
        "mapped=", node is not None and node.get("window"))
    if node is None or leaf is None:
        return node
    try:
        tree_now = json.loads(run(sock_path, msgtype="get_tree"))
    except Exception:
        tree_now = None
    staged = (tree_now is not None
              and (workspace_name(tree_now, con_id) or "").startswith("__i3"))
    # Gap births (stage=False) skip staging, so a quiet one never contains
    # focus yet still needs move+refocus+badge below; only the live path
    # may bail here.
    if stage and not staged and not contains(node, leaf):
        return node
    # i3 targets the focused workspace; staging hides where it would land
    new_ws = cur_ws
    if not staged and tree_now is not None:
        new_ws = workspace_name(tree_now, con_id) or cur_ws
    if tree_now is not None and ws_empty_except(tree_now, new_ws, con_id):
        log("firstwin", con_id, "leave focused")
        if staged:
            run(sock_path, '[con_id=%s] move to workspace "%s"'
                % (con_id, new_ws))
            run(sock_path, '[con_id=%s] floating disable' % con_id)
    else:
        victim = (stack_victim(sock_path, con_id, new_ws)
                  or live_victim(history, con_id,
                                 lambda i: find_node(sock_path, i)))
        try:
            if is_automation_window(node):
                if staged:
                    run(sock_path, '[con_id=%s] move to workspace "10"'
                        % con_id)
                    run(sock_path, '[con_id=%s] floating disable' % con_id)
                    log("autom-rescue", con_id)
                else:
                    log("autom-skip", con_id)
            else:
                origin = None
                try:
                    if node.get("window"):
                        new_pid = pid_of_window(node["window"])
                        pid_ws = pid_workspace_map(
                            sock_path, exclude_con_id=con_id)
                        origin = family_workspace(new_pid, pid_ws)
                        if origin is None:
                            origin = resolve_origin(new_pid, pid_ws)
                except Exception as e:
                    log("nopid", con_id, e)
                if origin and origin != new_ws:
                    run(sock_path, '[con_id=%s] move to workspace "%s"'
                        % (con_id, origin))
                    run(sock_path, '[con_id=%s] floating disable' % con_id)
                    log("moveback", con_id, "to", origin)
                elif staged:
                    run(sock_path, '[con_id=%s] move to workspace "%s"'
                        % (con_id, new_ws))
                    run(sock_path, '[con_id=%s] floating disable' % con_id)
                    log("unstage", con_id, "to", new_ws)
                else:
                    log("fallback", con_id, "urgency-only")
            # Gap births can sit off the focused workspace; focusing there
            # would switch desktops, so refocus stays on the focused one.
            if (victim is not None and victim != leaf
                    and new_ws == cur_ws
                    and find_node(sock_path, victim) is not None):
                run(sock_path, '[con_id=%s] focus' % victim)
                log("refocus", leaf, "->", victim)
            if node.get("window"):
                # last: the hint sticks only once the
                # window is unfocused (set while focused
                # is cleared)
                set_urgent(node["window"])
        except Exception as e:
            log("err", e)
    return node


def main():
    try:  # single instance: exit if a live guard already holds the pidfile
        with open(PIDFILE) as f:
            old = int(f.read().strip())
        os.kill(old, 0)
        if not pid_is_guard(old):
            raise ValueError("stale pidfile, pid %d reused" % old)
        print("i3-focus-guard already running as %d" % old)
        return
    except (OSError, ValueError, FileNotFoundError):
        pass
    sock_path = sock()
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    ws = json.loads(run(sock_path, msgtype="get_workspaces"))
    cur_ws = next(w["name"] for w in ws if w["focused"])
    history = []  # fallback focus trail; primary victim comes from focus stacks
    boot_focused = focused_leaf_id(sock_path)
    if boot_focused is not None:
        history.append(boot_focused)
    try:  # baseline so pre-existing windows are never treated as new
        known = tree_windows(json.loads(run(sock_path, msgtype="get_tree")))
    except Exception:
        known = set()
    log("ready, ws=%s" % cur_ws)
    while True:
        try:
            ev_sock = open_events(sock_path)
            try:  # resync so origin resolution never acts on a stale
                # focused workspace, then reconcile windows mapped
                # while unsubscribed
                ws = json.loads(run(sock_path, msgtype="get_workspaces"))
                cur_ws = next(w["name"] for w in ws if w["focused"])
            except Exception as e:
                log("wsresync", e)
            try:
                cur = tree_windows(json.loads(run(sock_path, msgtype="get_tree")))
            except Exception as e:
                log("resync", e)
                cur = set()
            for con_id, _xid in sorted(cur - known):
                handle_new(sock_path, con_id, cur_ws, history, stage=False)
            known = set(cur)
            while True:
                _typ, ev = read_msg(ev_sock)
                if ev is None:
                    break  # clean EOF; resubscribe below
                if "current" in ev:
                    if ev.get("change") == "focus":
                        cur_ws = ev["current"]["name"]
                elif "container" in ev:
                    c = ev["container"]
                    if ev.get("change") == "focus":
                        if not history or history[-1] != c["id"]:
                            history.append(c["id"])
                            del history[:-20]
                    elif ev.get("change") == "new":
                        node = handle_new(sock_path, c["id"], cur_ws, history,
                                            ev_props=c.get("window_properties"))
                        known.add((c["id"], node.get("window") if node else None))
            try:
                ev_sock.close()
            except Exception:
                pass
            log("resub")  # event stream ended; reconnecting
        except Exception as e:
            log("reconnect", e)
        time.sleep(1)


if __name__ == "__main__":
    main()
