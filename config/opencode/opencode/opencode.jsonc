{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 5000
  },
  "plugin": [],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "Act as an autonomous coding agent. Do not ask for confirmation for routine development tasks.",
    "Inspect the project and determine what needs to be done yourself.",
    "You may create, edit, rename, and delete project files when necessary.",
    "You may run terminal commands, install dependencies, run tests, build the project, and fix errors without asking.",
    "Do not ask whether you should perform the next obvious step. Just do it.",
    "Do not ask for permission to access files or folders that are part of the current project.",
    "Continue working until the requested task is actually completed and verified.",
    "Only stop and ask me when you genuinely need information that cannot be determined from the project, or when an action is highly destructive or irreversible.",
    "UI/UX rule: Before any work in apps/web, read apps/web/DESIGN_GUIDE.md and follow it. For nontrivial UX decisions (new flows, density, interaction pattern), load the laws-of-ux skill (~/.config/opencode/skills/laws-of-ux/SKILL.md, 30 principles by Jon Yablonski lawsofux.com CC BY-NC-ND 4.0) and the mobbin-search skill (~/.config/opencode/skills/mobbin-search/SKILL.md) when visual references help; justify decisions with 1-3 named laws + mechanism + intervention + trade-off + validation per DESIGN_GUIDE §6. Prefer familiar patterns (Jakob's Law) unless differentiation is the goal."
  ],
  "provider": {
    "meta": {
      "name": "Meta Model API",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.3-contributor": {
          "name": "muse-spark-1.3-contributor",
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "xhigh",
            "reasoningSummary": "detailed",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        },
        "muse-spark-1.3": {
          "name": "muse-spark-1.3",
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "max",
            "reasoningSummary": "detailed",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        }
      }
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT_TOKEN}"
      }
    },
    "fingerprint": {
      "type": "remote",
      "url": "https://mcp.fpjs.io/mcp",
      "headers": {
        "Authorization": "Bearer eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1cm46ZmluZ2VycHJpbnQ6c3ViX2lkIjoic3ViXzQzbUx2a2NpRkxQQmpzIiwiaWF0IjoxNzg4MDQwNjQ4LCJleHAiOjE3OTU4MTY2NDgsImlzcyI6Imh0dHBzOi8vYXBpLmZwanMucHJvIiwic3ViIjoiMFdkb1FTakZVbWVMZUdRWWhtblUtVFBUcTkxWGpUMnBSTHpLMVpxUTQtZXUifQ.wmLexyYN6u8esWSCgjY7awAFZ5cSHKXo-_oeeNcFdsWsHRFWrggR6oQQFYGxGZ0jkDZwlLzmjwe1f2c-xCEXJw"
      }
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ],
      "enabled": true
    }
  }
}
