{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "buffer": 5000
  },
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    }
  ],
  "providers": {
    "meta": {
      "name": "Meta Model API",
      "env": [
        "MODEL_API_KEY"
      ],
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.3-contributor": {
          "name": "muse-spark-1.3-contributor",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "settings": {
            "reasoningEffort": "xhigh",
            "reasoningSummary": "detailed",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        },
        "muse-wonder-1.0": {
          "name": "muse-wonder-1.0",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf",
              "video",
              "audio"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "settings": {
            "reasoningEffort": "max",
            "reasoningSummary": "detailed",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        }
      }
    },
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": false,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PAT_TOKEN}"
        }
      },
      "fingerprint": {
        "type": "remote",
        "url": "https://mcp.fpjs.io/mcp",
        "headers": {
          "Authorization": "Bearer {env:FINGERPRINT_MCP_KEY}"
        }
      },
      "shadcn": {
        "type": "local",
        "command": [
          "npx",
          "shadcn@latest",
          "mcp"
        ],
        "disabled": false
      },
      "next-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "next-devtools-mcp@latest"
        ],
        "disabled": false
      }
    }
  }
}
